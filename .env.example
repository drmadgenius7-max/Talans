# ============================================================================
# قِطّة | Qitta — Environment Variables
# Copy this file to .env and fill in real values for local development.
# NEVER commit real secrets. All defaults below are safe for local dev only.
# ============================================================================

# --- App ---
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://qitta:qitta_dev_password@localhost:5432/qitta_dev?schema=public"

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-insecure-secret-change-me-please-32chars-min"
SESSION_COOKIE_NAME="qitta_session"
# Session lifetime in days
SESSION_MAX_AGE_DAYS="30"

# --- Payments ---
# "mock" is the only implementation available today. Setting anything else
# in production without a real provider wired up will disable real payments
# (see src/server/payments/provider.ts).
PAYMENT_PROVIDER="mock"
PAYMENT_WEBHOOK_SECRET="dev-only-webhook-secret"

# --- Storage ---
# "local" stores uploaded files on disk under ./storage/uploads
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./storage/uploads"
# Max upload size in bytes (default 10MB)
STORAGE_MAX_UPLOAD_BYTES="10485760"

# --- SMS / OTP provider (mock until a real provider is wired up) ---
SMS_PROVIDER="mock"

# --- WhatsApp provider (mock) ---
WHATSAPP_PROVIDER="mock"

# --- Email provider (mock — logs to console in dev) ---
EMAIL_PROVIDER="mock"
EMAIL_FROM="Qitta <no-reply@qitta.sa>"

# --- OCR / Receipt scanning provider (mock, not implemented) ---
OCR_PROVIDER="none"

# --- Locale / Timezone defaults ---
DEFAULT_LOCALE="ar"
DEFAULT_TIMEZONE="Asia/Riyadh"
DEFAULT_CURRENCY="SAR"

# --- Demo / seed ---
# Enables the seed script's demo dataset. Never set true in production.
ENABLE_DEMO_SEED="true"
