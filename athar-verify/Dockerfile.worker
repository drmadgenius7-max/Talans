# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Athar Verify — media worker
#
# Runs the BullMQ consumer that performs fingerprinting, frame extraction, and
# similarity analysis. Only needed when REDIS_URL is configured; without Redis
# the web container executes these jobs inline.
# ---------------------------------------------------------------------------

FROM node:22-bookworm-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg openssl ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund

COPY prisma ./prisma
ENV DATABASE_URL="postgresql://build:build@localhost:5432/build"
RUN npx prisma generate

COPY tsconfig.json ./
COPY src ./src
COPY worker ./worker

RUN groupadd --system --gid 1001 nodejs \
 && useradd --system --uid 1001 --gid nodejs athar \
 && mkdir -p /app/storage-data && chown -R athar:nodejs /app

USER athar

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["npx", "tsx", "worker/index.ts"]
