// Athar Verify — Prisma schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING // قيد التنفيذ
  EXECUTED // تم التنفيذ
  DELIVERED // تم التسليم
  CANCELLED // ملغي
}

enum DocumentationKind {
  VIDEO
  IMAGE
  DOCUMENT
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum VerificationResult {
  VERIFIED_ORIGINAL // 🟢 مطابق للنسخة الأصلية (hash match)
  VERIFIED_CONTENT_MATCH // 🟢 مطابق للمحتوى (إعادة ضغط/ترميز)
  UNABLE_TO_VERIFY // 🟡 تعذر التأكد بشكل كامل
  NO_MATCH // 🔴 لا يتطابق
  ERROR // خطأ فني أثناء الفحص
}

enum CheckSource {
  CUSTOMER_UPLOAD
  ADMIN_UPLOAD
  LOOKUP // مجرد فتح صفحة التحقق دون رفع ملف
}

enum AdminRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum AiRiskLevel {
  NO_STRONG_SIGNALS // لم تظهر مؤشرات قوية
  SOME_SIGNALS // ظهرت بعض المؤشرات التي تستحق المراجعة
  INCONCLUSIVE // غير حاسم / لم يكتمل التحليل
}

// ---------------------------------------------------------------------------
// Core domain
// ---------------------------------------------------------------------------

model Order {
  id               String      @id @default(cuid())
  orderNumber      String      @unique @map("order_number")
  customerName     String?     @map("customer_name")
  /// Never exposed publicly. Stored for internal reconciliation only.
  customerPhone    String?     @map("customer_phone")
  /// Customer opt-in for showing their name on the public verification page.
  showCustomerName Boolean     @default(false) @map("show_customer_name")
  countryCode      String      @map("country_code") // ISO-3166 alpha-2, e.g. "TD"
  countryNameAr    String      @map("country_name_ar")
  serviceType      String?     @map("service_type") // توزيع مصاحف / كتب ...
  executionDate    DateTime    @map("execution_date") @db.Date
  status           OrderStatus @default(EXECUTED)
  notes            String?
  createdById      String?     @map("created_by_id")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  deletedAt        DateTime?   @map("deleted_at")

  createdBy          Admin?              @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  documentation      Documentation[]
  verificationLinks  VerificationLink[]
  verificationChecks VerificationCheck[]

  @@index([countryCode])
  @@index([executionDate])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model Documentation {
  id      String @id @default(cuid())
  orderId String @map("order_id")

  kind             DocumentationKind @default(VIDEO)
  /// Storage key inside the configured object store (never a public URL).
  storageKey       String            @map("storage_key")
  storageDriver    String            @map("storage_driver") // s3 | r2 | supabase | local
  originalFilename String            @map("original_filename")
  /// Immutable once written. The digital fingerprint of the original file.
  sha256           String
  filesize         BigInt
  mimeType         String            @map("mime_type")
  durationSeconds  Float?            @map("duration_seconds")

  /// Full ffprobe output + derived technical facts (admin-facing).
  metadataJson     Json? @map("metadata_json")
  /// Ordered array of perceptual hashes, one per sampled frame.
  frameHashes      Json? @map("frame_hashes")
  /// Coarse audio fingerprint + waveform statistics.
  audioFingerprint Json? @map("audio_fingerprint")

  thumbnailKey String? @map("thumbnail_key")

  processingStatus ProcessingStatus @default(PENDING) @map("processing_status")
  processingError  String?          @map("processing_error")
  processedAt      DateTime?        @map("processed_at")

  /// Whether customers are allowed to download the original file.
  downloadAllowed Boolean @default(true) @map("download_allowed")
  /// Primary documentation shown on the verification page.
  isPrimary       Boolean @default(true) @map("is_primary")
  sortOrder       Int     @default(0) @map("sort_order")

  uploadedById String?   @map("uploaded_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  uploadedBy Admin?              @relation("DocUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  checks     VerificationCheck[]

  @@index([orderId])
  @@index([sha256])
  @@index([processingStatus])
  @@map("documentation")
}

model VerificationLink {
  id             String @id @default(cuid())
  orderId        String @map("order_id")
  /// Public, human-shareable id: ATH-XXXXXXXX
  verificationId String @unique @map("verification_id")
  /// Unguessable secret embedded in the QR/short link.
  token          String @unique
  /// SHA-256 of the token, used for constant-time-ish indexed lookup.
  tokenHash      String @unique @map("token_hash")

  isActive     Boolean   @default(true) @map("is_active")
  expiresAt    DateTime? @map("expires_at")
  viewCount    Int       @default(0) @map("view_count")
  lastViewedAt DateTime? @map("last_viewed_at")

  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy Admin? @relation("LinkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("verification_links")
}

model VerificationCheck {
  id              String  @id @default(cuid())
  orderId         String? @map("order_id")
  documentationId String? @map("documentation_id")

  source CheckSource @default(CUSTOMER_UPLOAD)

  uploadedFilename String? @map("uploaded_filename")
  uploadedFileHash String? @map("uploaded_file_hash")
  uploadedFilesize BigInt? @map("uploaded_filesize")
  uploadedMimeType String? @map("uploaded_mime_type")

  hashMatch Boolean @default(false) @map("original_hash_match")

  /// 0..100
  similarityScore Float?       @map("similarity_score")
  audioSimilarity Float?       @map("audio_similarity")
  durationDelta   Float?       @map("duration_delta")
  /// 0..100 — higher means *more* signals of synthetic/manipulated media.
  aiSignalScore   Float?       @map("ai_signal_score")
  aiRiskLevel     AiRiskLevel? @map("ai_risk_level")
  aiProvider      String?      @map("ai_provider")

  /// 0..100 overall confidence in the stated result.
  confidenceScore Float?             @map("confidence_score")
  result          VerificationResult @default(UNABLE_TO_VERIFY)

  /// Full structured report (signals, metadata comparison, notes).
  reportJson Json? @map("report_json")

  processingStatus ProcessingStatus @default(PENDING) @map("processing_status")
  processingError  String?          @map("processing_error")

  /// Truncated / hashed for privacy — never a raw full IP in logs we expose.
  ipHash    String? @map("ip_hash")
  userAgent String? @map("user_agent")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  documentation Documentation? @relation(fields: [documentationId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
  @@index([result])
  @@index([uploadedFileHash])
  @@map("verification_checks")
}

// ---------------------------------------------------------------------------
// Admin / auth
// ---------------------------------------------------------------------------

model Admin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(OPERATOR)
  isActive     Boolean   @default(true) @map("is_active")

  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until")
  lastLoginAt       DateTime? @map("last_login_at")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sessions      AdminSession[]
  ordersCreated Order[]            @relation("OrderCreatedBy")
  docsUploaded  Documentation[]    @relation("DocUploadedBy")
  linksCreated  VerificationLink[] @relation("LinkCreatedBy")
  auditLogs     AuditLog[]

  @@map("admins")
}

model AdminSession {
  id        String    @id @default(cuid())
  adminId   String    @map("admin_id")
  /// SHA-256 of the opaque session secret held in the cookie.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  ipHash    String?   @map("ip_hash")
  userAgent String?   @map("user_agent")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?  @map("admin_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  detail     Json?
  ipHash     String?  @map("ip_hash")
  createdAt  DateTime @default(now()) @map("created_at")

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}

/// Durable rate-limit buckets. Used when Redis is not configured so that
/// limits still hold across serverless instances.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}
