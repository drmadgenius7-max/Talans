# ---------------------------------------------------------------------------
# Athar Verify — نموذج متغيرات البيئة
# انسخ هذا الملف إلى .env ثم عدّل القيم.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- التطبيق ---------------------------------------------------------------
NODE_ENV=development
# العنوان العام للتطبيق. يُستخدم في بناء روابط التحقق و QR Code.
APP_URL=http://localhost:3000
# العنوان القصير الرسمي (اختياري). إن ضُبط استُخدم في روابط QR بدل APP_URL.
# مثال: https://verify.athrr-sa.com
PUBLIC_VERIFY_BASE_URL=

# --- قاعدة البيانات --------------------------------------------------------
DATABASE_URL=postgresql://athar:athar@localhost:5432/athar_verify?schema=public

# --- الأمان ----------------------------------------------------------------
# سر توقيع الجلسات و الروابط. 32 بايت على الأقل.
#   openssl rand -base64 48
AUTH_SECRET=change-me-please-generate-a-long-random-secret-value
# سر مستقل لاشتقاق hash عناوين IP في السجلات (يمنع ربطها بالمستخدم).
IP_HASH_SALT=change-me-too-another-random-value
# مدة جلسة الإدارة بالساعات.
SESSION_TTL_HOURS=12

# --- التخزين ---------------------------------------------------------------
# s3 | r2 | supabase | local
STORAGE_DRIVER=local
# مجلد التخزين عند استخدام السائق المحلي (للتطوير فقط).
LOCAL_STORAGE_DIR=./storage-data

# S3 / Cloudflare R2 / Supabase Storage (متوافقة مع S3)
S3_BUCKET=athar-verify
S3_REGION=auto
# R2:       https://<account-id>.r2.cloudflarestorage.com
# Supabase: https://<project-ref>.supabase.co/storage/v1/s3
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# مطلوب لمعظم مزودي S3 البديلين.
S3_FORCE_PATH_STYLE=true
# مدة صلاحية روابط الرفع/التنزيل الموقّعة بالثواني.
S3_PRESIGN_EXPIRY_SECONDS=900

# --- الطابور والمعالجة في الخلفية ------------------------------------------
# اتركه فارغًا لتشغيل المهام بشكل متزامن داخل نفس العملية (وضع inline).
REDIS_URL=
QUEUE_PREFIX=athar-verify
# عدد المهام المتوازية في الـ worker.
QUEUE_CONCURRENCY=2

# --- FFmpeg ----------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# عدد الإطارات التي تُستخرج من كل فيديو لبناء البصمة الإدراكية.
# القيمة الأعلى تحسّن التعرف على المقاطع المقصوصة بشكل ملحوظ (قياسًا: 32 إطارًا
# أعطت تشابهًا 69% لمقطع مقصوص، بينما 64 إطارًا أعطت 91%) دون أي أثر على
# التمييز بين المقاطع المختلفة. التكلفة الإضافية ضئيلة مقارنة بفك ترميز الفيديو.
FRAME_SAMPLE_COUNT=64
# الحد الأقصى لمدة تنفيذ أمر ffmpeg بالمللي ثانية.
FFMPEG_TIMEOUT_MS=120000

# --- حدود الملفات ----------------------------------------------------------
# الحد الأقصى لحجم فيديو التوثيق الأصلي (بايت) — 1 GB.
MAX_UPLOAD_BYTES=1073741824
# الحد الأقصى لحجم الملف الذي يرفعه العميل للمقارنة (بايت) — 300 MB.
MAX_CUSTOMER_UPLOAD_BYTES=314572800

# --- تحليل الذكاء الاصطناعي ------------------------------------------------
# mock | heuristic | http
AI_ANALYSIS_PROVIDER=heuristic
# عند استخدام مزود http خارجي:
AI_ANALYSIS_API_URL=
AI_ANALYSIS_API_KEY=
AI_ANALYSIS_TIMEOUT_MS=30000

# --- حدود الطلبات (Rate limiting) ------------------------------------------
RATE_LIMIT_LOOKUP_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_HOUR=12
RATE_LIMIT_LOGIN_PER_15MIN=8

# --- بيانات البذر (seed) ---------------------------------------------------
SEED_ADMIN_EMAIL=admin@athrr-sa.com
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_NAME=مدير النظام
